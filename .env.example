# ─────────────────────────────────────────────────────────────────────────
# mycoach — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────
# Base URL of the Next.js frontend (used for CORS and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Neon serverless Postgres) ─────────────────────────────────
# Connection string from Neon dashboard. Format:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Go API server ───────────────────────────────────────────────────────
API_PORT=8080
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Secret used to sign auth session tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# How long a session token is valid, e.g. 168h (7 days)
SESSION_TTL=168h

# ── AI service (Python/FastAPI) ─────────────────────────────────────────
# Base URL of the FastAPI AI service
AI_SERVICE_URL=http://localhost:8000
# Shared secret the Go API sends to the AI service (X-AI-Service-Key)
AI_SERVICE_SHARED_KEY=

# API key for the LLM provider used by the AI service (e.g. Anthropic, OpenAI, Groq…)
AI_API_KEY=

# Optional: base URL / model override for the LLM provider used by the AI service
AI_BASE_URL=
AI_MODEL=

# ── GitHub OAuth (used for Open Source environment) ─────────────────────
# Create an OAuth app at https://github.com/settings/developers
# Callback URL must be: <NEXT_PUBLIC_APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Required OAuth scopes (repo needed to read private repos and open PRs)
GITHUB_SCOPES=read:user,repo
